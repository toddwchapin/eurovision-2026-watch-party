{
  "rules": {
    "$year": {
      "parties": {
        "$partyCode": {
          "users": {
            ".read": true,
            "$userId": {
              ".write": true,
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "votes": {
                "$stage": {
                  "$actCode": {
                    ".validate": "newData.hasChildren(['vocals','performance','song','original','stage','total'])",
                    "vocals":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                    "performance": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                    "song":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                    "original":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                    "stage":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                    "total":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 25" },
                    "remind":      { ".validate": "newData.isString() && newData.val().length <= 200" }
                  }
                }
              }
            }
          },
          "funniest": {
            ".read": true,
            "$stage": {
              ".write": true,
              ".validate": "newData.hasChildren(['userId','actCode','comment','score','scorerVersion'])",
              "userId":        { ".validate": "newData.isString() && newData.val().length <= 32" },
              "actCode":       { ".validate": "newData.isString() && newData.val().length <= 8" },
              "comment":       { ".validate": "newData.isString() && newData.val().length <= 200" },
              "score":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 25" },
              "scoredAt":      { ".validate": "newData.isNumber()" },
              "scorerVersion": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "$other":        { ".validate": false }
            }
          }
        }
      }
    }
  }
}
